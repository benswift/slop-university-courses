{
  "name": "slop-course-catalogue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "oxlint && pnpm lint:css",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "lint:css:fix": "stylelint --allow-empty-input --fix \"src/**/*.css\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "catalogue:sync": "tsx scripts/sync-courses.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@iconify-json/iconoir": "^1.2.11",
    "astro": "^7.3.1",
    "astro-theme-slop": "github:benswift/astro-theme-slop#v0.1.0",
    "astro-theme-university": "git+https://github.com/ANUcybernetics/astro-theme-university.git#v0.14.4",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@e18e/eslint-plugin": "^0.8.0",
    "@types/node": "^24.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
