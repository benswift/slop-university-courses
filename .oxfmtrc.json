{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": { "compressHTML": "html" },
  "ignorePatterns": ["dist/", ".astro/", "src/data/catalogue.json"],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
